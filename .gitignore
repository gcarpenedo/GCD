*.xpr
*.jou
*.log
*.str
*.pb
*.rpx
*.wdb
*.wcfg
*.zip
*.tmp

# Generated implementation outputs.
*.dcp
*.bit
*.bin
*.mcs
*.ltx
*.hwdef
*.hdf
*.xsa

# Editor and operating-system clutter.
.DS_Store
.vscode/
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.swp
*.out
*~

# Python virtual environments and caches.
venv/
